{
  "compilerOptions": {
    "allowJs": true,
    "strict": false,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
